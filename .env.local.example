# HanClass Environment Variables
# Copy this file to .env.local and fill in your values

# DeepSeek API Key for AI question generation
# Get your API key from: https://platform.deepseek.com/
# IMPORTANT: Do NOT prefix with VITE_ - this is a backend-only variable
DEEPSEEK_API_KEY=

# Optional: Override default API URL (usually not needed)
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Optional: AI endpoint protection (defaults shown below)
# AI_RATE_LIMIT_MAX=8
# AI_RATE_LIMIT_WINDOW_MS=600000

# Local production-server test only. Zeabur injects PORT automatically.
# PORT=8080
